# =============================================================================
# Query: Overdue Tasks
# =============================================================================
# Purpose: Find Actions that are past their due date and not completed
# Parameters:
#   - ?CUTOFF_DATE: injected as current UTC datetime at query time
# Returns: plan_name, due_date, scheduled_at, status, priority_level
# Usage: Daily/weekly overdue task review
# =============================================================================

PREFIX actions: <https://clearhead.us/vocab/actions/v4#>
PREFIX cco: <https://www.commoncoreontologies.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?plan_name ?due_date ?scheduled_at ?phase ?priority_level WHERE {
    VALUES ?cutoff { ?CUTOFF_DATE }

    ?act a actions:Action ;
         cco:ont00001868 ?status ;
         actions:hasDueDateTime ?due_date .

    FILTER(?status != actions:Completed && ?status != actions:Cancelled)
    FILTER(?due_date <= ?cutoff)

    ?plan cco:ont00001942 ?act ;
          rdfs:label ?plan_name .

    BIND(STRAFTER(STR(?status), "#") AS ?phase)

    OPTIONAL { ?act actions:hasScheduledDateTime ?scheduled_at }
    OPTIONAL { ?plan actions:hasPriority ?priority_level }
}
ORDER BY ?priority_level ?due_date
