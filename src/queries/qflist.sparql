# =============================================================================
# Query: Quickfix List
# =============================================================================
# Purpose: Open actions with source locations for editor navigation (qflist).
#          Each row carries ws_root so the consumer can resolve the relative
#          source_file to an absolute path without external context.
# Returns: name, status, source_file, source_line, ws_root
# =============================================================================

PREFIX actions: <https://clearhead.us/vocab/actions/v4#>
PREFIX cco: <https://www.commoncoreontologies.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX ws: <https://clearhead.us/vocab/workspace/v1#>

SELECT ?name ?status ?source_file ?source_line ?ws_root WHERE {
    GRAPH ?g {
        ?act a actions:Action ;
             rdfs:label ?name ;
             cco:ont00001868 ?raw_state ;
             ws:hasSourceFile ?source_file ;
             ws:hasSourceLine ?source_line .
        ?workspace_node a ws:Workspace ;
                        ws:root ?ws_root .
        FILTER(?raw_state != actions:Completed && ?raw_state != actions:Cancelled)
    }
    BIND(STRAFTER(STR(?raw_state), "#") AS ?status)
}
ORDER BY ?ws_root ?source_file ?source_line
