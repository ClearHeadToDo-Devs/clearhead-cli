# =============================================================================
# Query: Open Plans
# =============================================================================
# Purpose: Find Plans with an act that is not yet Completed or Cancelled
# Returns: plan_name, phase, due_date, priority_level
# Usage: Full backlog view — everything still in flight
# =============================================================================

PREFIX actions: <https://clearhead.us/vocab/actions/v4#>
PREFIX cco: <https://www.commoncoreontologies.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?plan_name ?phase ?due_date ?priority_level WHERE {
    ?plan a cco:ont00000974 ;
          rdfs:label ?plan_name ;
          cco:ont00001942 ?act .

    ?act a actions:Action ;
         cco:ont00001868 ?status .

    FILTER(?status != actions:Completed && ?status != actions:Cancelled)

    BIND(STRAFTER(STR(?status), "#") AS ?phase)

    OPTIONAL { ?act actions:hasDueDateTime ?due_date }
    OPTIONAL { ?plan actions:hasPriority ?priority_level }
}
ORDER BY ?priority_level ?due_date ?plan_name
