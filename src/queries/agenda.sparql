# =============================================================================
# Query: Agenda
# =============================================================================
# Purpose: Actions scheduled or due on or before now — today's work
# Parameters:
#   ?NOW — injected as current UTC datetime at query time
# Returns: name, scheduled_at, due_date, state
# =============================================================================

PREFIX actions: <https://clearhead.us/vocab/actions/v4#>
PREFIX cco: <https://www.commoncoreontologies.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT DISTINCT ?name ?scheduled_at ?due_date ?state WHERE {
    VALUES ?now { ?NOW }

    ?act a actions:Action ;
         rdfs:label ?name ;
         cco:ont00001868 ?raw_state .

    FILTER(?raw_state != actions:Completed && ?raw_state != actions:Cancelled)
    BIND(STRAFTER(STR(?raw_state), "#") AS ?state)

    OPTIONAL { ?act actions:hasScheduledDateTime ?scheduled_at }
    OPTIONAL { ?act actions:hasDueDateTime ?due_date }

    FILTER(
        (BOUND(?scheduled_at) && ?scheduled_at <= ?now) ||
        (BOUND(?due_date) && ?due_date <= ?now)
    )
}
ORDER BY ?scheduled_at ?due_date ?name
